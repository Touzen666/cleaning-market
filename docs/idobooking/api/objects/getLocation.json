v>\n        </div>\n                <div class=\"api_details_item open\" data-parameter-name=\"objectLocations\">\n                    <div class=\"api_details_item_inner level0 toggle\">\n                        <strong class=\"api_required required_after\">objectLocations <span>(objectLocationArray)</span></strong>\n                        <span><p>Lista przedmiotów rezerwacji z danymi lokalizacji w postaci tablicy elementów typu objectLocation</p></span>\n                    </div>\n        \n            <div class=\"api_details_item_sub\">\n            \n                <div class=\"api_details_item open\" data-parameter-name=\"objectLocation\">\n                    <div class=\"api_details_item_inner level1 toggle\">\n                        <strong class=\"api_required required_after\"> <span>(objectLocation)</span></strong>\n                        <span><p>element typu objectLocation</p></span>\n                    </div>\n        \n            <div class=\"api_details_item_sub\">\n            \n                <div class=\"api_details_item\" data-parameter-name=\"objectId\">\n                    <div class=\"api_details_item_inner level2\">\n                        <strong class=\"api_required required_after\">objectId <span>(int)</span></strong>\n                        <span><p>Identyfikator przedmiotu rezerwacji</p></span>\n                    </div>\n        </div></div>\n            <div class=\"api_details_item_sub\">\n            \n                <div class=\"api_details_item\" data-parameter-name=\"locationId\">\n                    <div class=\"api_details_item_inner level2\">\n                        <strong class=\"api_required required_after\">locationId <span>(int)</span></strong>\n                        <span><p>Identyfikator lokalizacji</p></span>\n                    </div>\n        </div></div>\n            <div class=\"api_details_item_sub\">\n            \n                <div class=\"api_details_item\" data-parameter-name=\"address\">\