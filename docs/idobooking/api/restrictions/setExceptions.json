                 </div>\n        </div></div>\n            <div class=\"api_details_item_sub\">\n            \n                <div class=\"api_details_item\" data-parameter-name=\"lengthStay\">\n                    <div class=\"api_details_item_inner level3\">\n                        <strong class=\"\">lengthStay <span>(int)</span></strong>\n                        <span><p></p></span>\n                    </div>\n        </div></div></div></div></div></div></div></div></div>\n        <div id=\"api_method_response_json\" class=\"mb-5\"><div class=\"api_method_header px-3\"><div class=\"api_method_header_left d-flex flex-wrap justify-content-center justify-content-sm-between align-items-center\"><div><i class=\"icon-code\"></i> \n            <strong>Struktura odpowiedzi</strong></div></div></div><div id=\"api_method_response_content\" class=\"api_details visible\">\n                <div class=\"api_details_item open\" data-parameter-name=\"authenticate\">\n                    <div class=\"api_details_item_inner level0 toggle\">\n                        <strong class=\"\">authenticate <span>(authenticateType)</span></strong>\n                        <span><p>Element zawierający informacje zwrotne z modułu autoryzującego</p></span>\n                    </div>\n        \n            <div class=\"api_details_item_sub\">\n            \n                <div class=\"api_details_item\" data-parameter-name=\"systemKey\">\n                    <div class=\"api_details_item_inner level1\">\n                        <strong class=\"api_required required_after\">systemKey <span>(string)</span></strong>\n                        <span><p>Klucz wykorzystywany podczas uwierzytelniania. Zapoznaj się z <a href=\"https://pomoc.idobooking.com/dodatkowe-moduly/api\">instrukcją generowania klucza</a></p></span>\n                    </div>\n        </div></div>\n            <div class=\"api_details_item_sub\">\n            \n                <div class=\"api_details_item\" data-parameter-name=\"systemLogin\">\n                    <div class=\"api_details_item_inner level1\">\n                        <strong class=\"api_required required_after\">systemLogin <span>(string)</span></strong>\n                        <span><p>Login użytkownika panelu IdoSell Booking</p></span>\n                    </div>\n        </div></div>\n            <div class=\"api_details_item_sub\">\n            \n                <div class=\"api_details_item\" data-parameter-name=\"lang\">\n                    <div class=\"api_details_item_inner level1\">\n                        <strong class=\"\">lang <span>(apiLanguage)</span></strong>\n                        <span><p>\n                    <span>Możliwe wartości:\n                    </span> (<i>eng, pol, ger</i>)</p><p>Język API</p></span>\n                    </div>\n        </div></div></div>\n                <div class=\"api_details_item open\" data-parameter-name=\"errors\">\n                    <div class=\"api_details_item_inner level0 toggle\">\n                        <strong class=\"\">errors <span>(gateErrorType)</span></strong>\n                        <span><p>Lista kodów błędów</p></span>\n                    </div>\n        \n            <div class=\"api_details_item_sub\">\n            \n                <div class=\"api_details_item\" data-parameter-name=\"faultCode\">\n                    <div class=\"api_details_item_inner level1\">\n                        <strong class=\"\">faultCode <span>(int)</span></strong>\n                        <span><p>Kod błędu</p></span>\n                    </div>\n        </div></div>\n            <div class=\"api_details_item_sub\">\n            \n                <div class=\"api_details_item\" data-parameter-name=\"faultString\">\n                    <div class=\"api_details_item_inner level1\">\n                        <strong class=\"\">faultString <span>(string)</span></strong>\n                        <span><p>Opis błędu</p></span>\n                    </div>\n        </div></div></div>\n                <div class=\"api_details_item\" data-parameter-name=\"success\">\n                    <div class=\"api_details_item_inner level0\">\n                        <strong class=\"\">success <span>(boolean)</span></strong>\n                        <span><p>Sukces</p></span>\n                    </div>\n        </div></div></div>\n        <div id=\"php-example_json\" class=\"code_example mb-5\"><div class=\"api_method_header px-3\"><div class=\"api_method_header_left d-flex flex-wrap justify-content-center justify-content-sm-between align-items-center\"><div><i class=\"icon-file-code\"></i> \n            <strong>Przykład kodu w PHP</strong></div></div></div><div class=\"api_details visible\">\n                <div id=\"php-example_content_json\">\n                    <pre class=\"highlight-code hljs php\"><span class=\"hljs-meta\">&lt;?php</span>\n\n$address = <span class=\"hljs-string\">'https://client1679.idobooking.com/api/restrictions/setExceptions/36/json'</span>;\n\n$request = <span class=\"hljs-keyword\">array</span>();\n$request[<span class=\"hljs-string\">'authenticate'</span>] = <span class=\"hljs-keyword\">array</span>();\n$request[<span class=\"hljs-string\">'authenticate'</span>][<span class=\"hljs-string\">'systemKey'</span>] = sha1(date(<span class=\"hljs-string\">'Ymd'</span>) . sha1(<span class=\"hljs-string\">'YOUR_KEY'</span>));\n$request[<span class=\"hljs-string\">'authenticate'</span>][<span class=\"hljs-string\">'systemLogin'</span>] = <span class=\"hljs-string\">\"systemLogin\"</span>;\n$request[<span class=\"hljs-string\">'authenticate'</span>][<span class=\"hljs-string\">'lang'</span>] = <span class=\"hljs-string\">'eng'</span>;\n$request[<span class=\"hljs-string\">'setRestrictionExceptions'</span>] = <span class=\"hljs-keyword\">array</span>();\n$request[<span class=\"hljs-string\">'setRestrictionExceptions'</span>][<span class=\"hljs-number\">0</span>] = <span class=\"hljs-keyword\">array</span>();\n$request[<span class=\"hljs-string\">'setRestrictionExceptions'</span>][<span class=\"hljs-number\">0</span>][<span class=\"hljs-string\">'objectsIds'</span>] = <span class=\"hljs-keyword\">array</span>();\n$request[<span class=\"hljs-string\">'setRestrictionExceptions'</span>][<span class=\"hljs-number\">0</span>][<span class=\"hljs-string\">'objectsIds'</span>][<span class=\"hljs-number\">0</span>] = <span class=\"hljs-number\">1</span>;\n$request[<span class=\"hljs-string\">'setRestrictionExceptions'</span>][<span class=\"hljs-number\">0</span>][<span class=\"hljs-string\">'offerType'</span>] = <span class=\"hljs-string\">\"offerType\"</span>;\n$request[<span class=\"hljs-string\">'setRestrictionExceptions'</span>][<span class=\"hljs-number\">0</span>][<span class=\"hljs-string\">'restrictionExceptionDateFrom'</span>] = <span class=\"hljs-string\">\"restrictionExceptionDateFrom\"</span>;\n$request[<span class=\"hljs-string\">'setRestrictionExceptions'</span>][<span class=\"hljs-number\">0</span>][<span class=\"hljs-string\">'restrictionExceptionDateTo'</span>] = <span class=\"hljs-string\">\"restrictionExceptionDateTo\"</span>;\n$request[<span class=\"hljs-string\">'setRestrictionExceptions'</span>][<span class=\"hljs-number\">0</span>][<span class=\"hljs-string\">'closedToArrival'</span>] = <span class=\"hljs-keyword\">true</span>;\n$request[<span class=\"hljs-string\">'setRestrictionExceptions'</span>][<span class=\"hljs-number\">0</span>][<span class=\"hljs-string\">'closedToDeparture'</span>] = <span class=\"hljs-keyword\">true</span>;\n$request[<span class=\"hljs-string\">'setRestrictionExceptions'</span>][<span class=\"hljs-number\">0</span>][<span class=\"hljs-string\">'lengthSetting'</span>] = <span class=\"hljs-keyword\">array</span>();\n$request[<span class=\"hljs-string\">'setRestrictionExceptions'</span>][<span class=\"hljs-number\">0</span>][<span class=\"hljs-string\">'lengthSetting'</span>][<span class=\"hljs-string\">'lengthMode'</span>] = <span class=\"hljs-string\">'free'</span>;\n$request[<span class=\"hljs-string\">'setRestrictionExceptions'</span>][<span class=\"hljs-number\">0</span>][<span class=\"hljs-string\">'lengthSetting'</span>][<span class=\"hljs-string\">'lengthType'</span>] = <span class=\"hljs-string\">'days'</span>;\n$request[<span class=\"hljs-string\">'setRestrictionExceptions'</span>][<span class=\"hljs-number\">0</span>][<span class=\"hljs-string\">'lengthSetting'</span>][<span class=\"hljs-string\">'lengthStay'</span>] = <span class=\"hljs-number\">2</span>;\n\n$request_json = json_encode($request);\n$headers = <span class=\"hljs-keyword\">array</span>(\n    <span class=\"hljs-string\">'Accept: application/json'</span>,\n    <span class=\"hljs-string\">'Content-Type: application/json;charset=UTF-8'</span>\n);\n\n$curl = curl_init($address);\ncurl_setopt($curl, CURLOPT_HTTP_VERSION, CURL_HTTP_VERSION_1_1);\ncurl_setopt($curl, CURLOPT_RETURNTRANSFER, <span class=\"hljs-number\">1</span>);\ncurl_setopt($curl, CURLOPT_SSL_VERIFYPEER, <span class=\"hljs-keyword\">false</span>);\ncurl_setopt($curl, CURLOPT_SSL_VERIFYHOST, <span class=\"hljs-keyword\">false</span>);\ncurl_setopt($curl, CURLOPT_FORBID_REUSE, <span class=\"hljs-number\">1</span>);\ncurl_setopt($curl, CURLINFO_HEADER_OUT, <span class=\"hljs-number\">1</span>);\ncurl_setopt($curl, CURLOPT_HEADER, <span class=\"hljs-number\">1</span>);\ncurl_setopt($curl, CURLOPT_POST, <span class=\"hljs-number\">1</span>);\ncurl_setopt($curl, CURLOPT_POSTFIELDS, $request_json);\ncurl_setopt($curl, CURLOPT_HTTPHEADER, $headers);\n\n$response = curl_exec($curl);\n$status = curl_getinfo($curl);\ncurl_close($curl);\n       </pre>\n                </div>\n            </div></div>\n        <div id=\"api_changelog_json\" class=\"mb-5\"><h2>Historia zmian</h2><p>W rozwiniętej historii metody nie wyświetlono wpisów zmian; dostępny był formularz porównywania wersji.</p></div></div></div></div>\n                        </div>\n                    </div>\n                